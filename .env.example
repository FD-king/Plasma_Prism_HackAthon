# Copy to .env and fill in your own values.

# Enable LLM-based note translation. Without this, the heuristic fallback runs.
# Get a key at: https://console.groq.com/keys  (prefix: gsk_)
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning
SOLVER_TIMEOUT=10.0
LOG_LEVEL=INFO
PORT=8000
RELOAD=0

# Frontend connectivity
BACKEND_URL=http://127.0.0.1:8000
USE_MOCK=0
