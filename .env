# Copy to .env and fill in your own values.

# Enable LLM-based note translation. Without this, the heuristic fallback runs.
# Get a key at: https://console.groq.com/keys  (prefix: gsk_)
GROQ_API_KEY=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

# Optional: override the Groq model (default: llama-3.1-70b-versatile)
# GROQ_MODEL=llama-3.1-70b-versatile

# Optional tuning
SOLVER_TIMEOUT=10.0
LOG_LEVEL=INFO
PORT=8000
RELOAD=0

# Frontend connectivity (Streamlit reads these)
BACKEND_URL=http://127.0.0.1:8000
USE_MOCK=0
